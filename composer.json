{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cboxdk/laravel-id-billing-bridge",
    "description": "Bridges Cbox ID domain events to the Cbox Billing client \u2014 meters identity usage (the shared auth.* vocabulary) to billing off the transactional outbox, exactly-once. Compose it in the SaaS; the self-hostable app stays billing-free.",
    "keywords": [
        "cbox",
        "identity",
        "billing",
        "metering",
        "bridge",
        "laravel"
    ],
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "cboxdk/laravel-billing-client": "^0.3",
        "cboxdk/laravel-id": "^0.19 || ^0.20 || ^0.21 || ^0.22",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.5 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Cbox\\Id\\BillingBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cbox\\Id\\BillingBridge\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "pest",
        "license-check": "@php bin/check-licenses.php",
        "sbom": "@php bin/generate-sbom.php",
        "qa": [
            "@lint",
            "@analyse",
            "@test",
            "@license-check",
            "@composer audit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cbox\\Id\\BillingBridge\\BillingBridgeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
