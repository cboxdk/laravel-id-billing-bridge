{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cboxdk/laravel-id-billing-bridge",
    "description": "Meters Cbox ID identity usage to a billing service — reads the shared auth.* vocabulary off the transactional outbox and reports it exactly once. Optional: install it only where you actually bill.",
    "keywords": [
        "cbox",
        "identity",
        "billing",
        "metering",
        "usage",
        "laravel"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "cboxdk/laravel-billing-client": "^0.4.14",
        "cboxdk/laravel-id": "^2.0.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.5 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Cbox\\Id\\BillingBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cbox\\Id\\BillingBridge\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "pest",
        "license-check": "@php bin/check-licenses.php",
        "sbom": "@php bin/generate-sbom.php",
        "qa": [
            "@lint",
            "@analyse",
            "@test",
            "@license-check",
            "@composer audit --no-dev"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cbox\\Id\\BillingBridge\\BillingBridgeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
